# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if you don't want to check in NuGet packages:
#packages/
# NuGet v3's project.json files
*.nuget.props
*.nuget.targets

# Microsoft Azure Service Fabric specific files
ApplicationParameters/
Cloud.xml
Local.xml
publishprofiles/

# Windows Installer files
# *.msix

# ClickOnce directory
publish/

# Precompile directory for websites
PrecompiledWeb/

# Options files
*.ccscc
*.sln.metaproj

# Paket files
.paket/paket.exe
paket-files/

# FAKE - F# Make
.fake/

# JetBrains Rider
.idea/
*.sln.iml

# CodeRush
.cr/

# Python - Django support
*.pyc

# Cake - C# Make
tools/**
!tools/packages.config

# Vim temporary files
*~
*.swp

# Test certificado
*.pfx

# Operations Management Suite (OMS) external data
*.ruleset.xml

# Local History for Visual Studio
.localhistory/

